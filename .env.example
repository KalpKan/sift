# Names only, never values. Real values live in Vercel: your project -> Settings -> Environment Variables
# (Production and Preview). Never commit a real .env file; .gitignore already blocks .env and .env.*.
# Every name starts with NEXT_PUBLIC_ so it is baked into the browser bundle at build time:
# change a value on Vercel, then redeploy.

# --- Supabase (Project B "platform", one schema per app). Leave all three empty to run with no database:
#     /api/health then answers db: "skipped". Get the URL and anon key from Supabase -> project "platform"
#     -> Project Settings -> API. The anon key is public by design (row-level security protects the data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The Postgres schema this app owns (lowercase, letters/digits/underscore). Same word you put in
# supabase/migrations/0001_create_schema.sql in place of __APP__.
NEXT_PUBLIC_APP_SCHEMA=

# --- Shown in /api/health "service" and in the footer. Defaults to NEXT_PUBLIC_APP_SCHEMA, then "template".
NEXT_PUBLIC_APP_NAME=

# --- PostHog analytics (KalpKan/portfolio docs/analytics.md). The key is the public phc_ project token
#     of the "Kalp portfolio" project; leave empty to run with analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
# Always /ingest: the app proxies analytics through its own origin (next.config.ts rewrites).
NEXT_PUBLIC_POSTHOG_HOST=/ingest
